# =============================================================================
# CLINICAL TRIAL RISK MONITOR — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore
# =============================================================================

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Ports ─────────────────────────────────────────────────────
BACKEND_PORT=3001
MCP_PORT=3002
FRONTEND_PORT=5173

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://admin:changeme@localhost:27017/ctrm?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=protocol_deviations

# ── LLM Provider (watsonx | openai | none) ───────────────────
# Set to 'none' if you have no LLM API key — CAPA generation will return stubs
LLM_PROVIDER=none

# ── IBM watsonx.ai ───────────────────────────────────────────
# Required when LLM_PROVIDER=watsonx
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── OpenAI (fallback) ─────────────────────────────────────────
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# ── Hugging Face ──────────────────────────────────────────────
HF_MODEL_ID=distilbert-base-uncased
HF_API_KEY=your_hf_api_key_here

# ── Embeddings ────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Caching ───────────────────────────────────────────────────
RISK_SCORE_CACHE_TTL_SECONDS=300

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── MCP Server ────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
MCP_TRANSPORT=stdio

# ── Seed data ─────────────────────────────────────────────────
SEED_PATIENT_COUNT=5000
SEED_SITE_COUNT=200
